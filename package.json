{
  "contributors": [
    {
      "name": "Yargs Contributors",
      "url": "https://github.com/yargs/yargs/graphs/contributors"
    }
  ],
  "dependencies": {
    "cliui": "^9.0.1",
    "escalade": "^3.1.1",
    "get-caller-file": "^2.0.5",
    "string-width": "^8.2.1",
    "y18n": "^5.0.5",
    "yargs-parser": "^22.0.0"
  },
  "description": "yargs the modern, pirate-themed, successor to optimist.",
  "devDependencies": {
    "@babel/eslint-parser": "^7.26.10",
    "@babel/preset-typescript": "^7.26.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^9.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "browserslist-generator": "^3.0.0",
    "c8": "^11.0.0",
    "chai": "^6.2.2",
    "chalk": "^5.6.2",
    "cpr": "^3.0.1",
    "cross-env": "^10.0.0",
    "cross-spawn": "^7.0.6",
    "eslint": "^8.57.1",
    "eslint-plugin-prettier": "^5.1.2",
    "gts": "^5.3.1",
    "hashish": "0.0.4",
    "mocha": "^11.7.6",
    "rimraf": "^3.0.2",
    "typescript": "^5.9.3",
    "which": "^2.0.2",
    "yargs-test-extends": "^1.0.1"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=23"
  },
  "exports": {
    ".": "./index.mjs",
    "./browser": {
      "import": "./browser.mjs",
      "types": "./browser.d.ts"
    },
    "./helpers": "./helpers/helpers.mjs",
    "./package.json": "./package.json",
    "./yargs": "./index.mjs"
  },
  "files": [
    "browser.mjs",
    "browser.d.ts",
    "helpers/*.js",
    "helpers/*",
    "index.mjs",
    "build",
    "locales",
    "LICENSE",
    "lib/platform-shims/*.mjs",
    "!*.d.ts",
    "!**/*.d.ts"
  ],
  "homepage": "https://yargs.js.org/",
  "keywords": [
    "argument",
    "args",
    "option",
    "parser",
    "parsing",
    "cli",
    "command"
  ],
  "license": "MIT",
  "main": "./index.mjs",
  "module": "./index.mjs",
  "name": "yargs",
  "overrides": {
    "browserslist": "4.29.5",
    "js-yaml": "4.3.2",
    "tmp": "0.2.7",
    "mocha": {
      "minimatch": "11.0.1",
      "serialize-javascript": "7.1.3"
    },
    "glob": {
      "minimatch": "11.0.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    },
    "test-exclude": {
      "minimatch": "11.0.1"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yargs/yargs.git"
  },
  "scripts": {
    "check": "gts lint && npm run check:js",
    "check:js": "eslint . --ext mjs --ext js",
    "clean": "gts clean",
    "compile": "rimraf build && tsc",
    "coverage": "c8 report --check-coverage",
    "fix": "gts fix && npm run fix:js",
    "fix:js": "eslint . --ext mjs --ext js --fix",
    "posttest": "npm run check",
    "prepare": "npm run compile",
    "pretest": "npm run compile -- -p tsconfig.test.json",
    "test": "c8 mocha --enable-source-maps ./test/*.mjs --require ./test/before.mjs --timeout=24000 --check-leaks",
    "test:esm": "c8 mocha --enable-source-maps ./test/esm/*.mjs --check-leaks",
    "watch": "rimraf build && npm:watch:tsc",
    "watch:tsc": "tsc --watch"
  },
  "type": "module",
  "version": "18.2.0"
}
